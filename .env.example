# Dhan API Credentials
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# Auto Token Refresh (set these for zero-touch operation)
# Your 6-digit Dhan login PIN
DHAN_PIN=
# TOTP secret from Dhan: Profile -> DhanHQ Trading APIs -> Setup TOTP
DHAN_TOTP_SECRET=

# Risk Management Settings (all values in INR)
DAILY_MAX_LOSS=5000
DAILY_PROFIT_TARGET=20000
MAX_OPEN_POSITIONS=5
MAX_SINGLE_TRADE_RISK=2000
MAX_ORDER_QUANTITY=325

# Profit Lock Settings
PROFIT_LOCK_THRESHOLD=10000
PROFIT_LOCK_PERCENTAGE=50

# Cooldown Settings (in seconds)
COOLDOWN_AFTER_LOSS=300
COOLDOWN_AFTER_CONSECUTIVE_LOSSES=600
CONSECUTIVE_LOSS_COUNT=3

# Trailing Drawdown Settings
TRAILING_DRAWDOWN_ENABLED=true
TRAILING_DRAWDOWN_PERCENTAGE=50

# Dashboard Settings
DASHBOARD_PORT=5555
DASHBOARD_HOST=0.0.0.0

# State Encryption Key (auto-generated on first run if not set)
STATE_ENCRYPTION_KEY=

# Position Monitor Interval (seconds)
MONITOR_INTERVAL=2
